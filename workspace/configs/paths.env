# Paths only. Model weights stay in the Hugging Face cache on the data disk.
HF_HOME=/root/autodl-tmp/huggingface
HUGGINGFACE_HUB_CACHE=/root/autodl-tmp/huggingface/hub
HF_ENDPOINT=https://hf-mirror.com
CHECKPOINT_DIR=/root/autodl-tmp/ASU-unlearning/checkpoints
WORKSPACE_DIR=/usr/local/ASU-unlearning/workspace

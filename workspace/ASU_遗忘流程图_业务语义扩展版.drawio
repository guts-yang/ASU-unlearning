<mxfile host="Electron" agent="WorkBuddy">
  <diagram id="asu-forget-flow-ext" name="ASU遗忘流程扩展">
    <mxGraphModel dx="1222" dy="916" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="840" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="ASU 遗忘流程扩展图：从触发遗忘到写回失效的完整闭环" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#26215C;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1160" height="28" as="geometry" />
        </mxCell>

        <mxCell id="mech" value="机制假设：事实性回答依赖尖锐、低熵的注意力关联；语法与流畅表达依赖宽泛的模式 → 对注意力做升温平滑，可选择性抹除事实、保留语言能力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontSize=12;fontColor=#633806;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1160" height="44" as="geometry" />
        </mxCell>

        <mxCell id="trigger" value="触发遗忘条件：确认目标知识需要抹除 → 圈定遗忘范围（待抹除问答对）与能力保持范围（保留集），并准备一份原模型副本作为参照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontSize=12;fontColor=#633806;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="102" width="1160" height="44" as="geometry" />
        </mxCell>

        <mxCell id="dr" value="&lt;b&gt;保留集&lt;/b&gt;&lt;br&gt;需保持的通用问答能力数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=12;fontColor=#042C53;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="176" width="230" height="64" as="geometry" />
        </mxCell>

        <mxCell id="retain" value="&lt;b&gt;保留效用信号&lt;/b&gt;&lt;br&gt;在保留集上维持问答能力：&lt;br&gt;直接拟合答案，或与原模型输出分布对齐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=12;fontColor=#042C53;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="176" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="effect" value="&lt;b&gt;遗忘效果判定（每轮末）&lt;/b&gt;&lt;br&gt;目标事实是否已答不出？&lt;br&gt;通用能力是否保持？&lt;br&gt;输出是否连贯（无乱码）？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontSize=12;fontColor=#633806;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="176" width="240" height="84" as="geometry" />
        </mxCell>

        <mxCell id="output" value="&lt;b&gt;遗忘后模型（写回）&lt;/b&gt;&lt;br&gt;遗忘问题得到连贯但无事实的输出&lt;br&gt;（非乱码、非拒答）&lt;br&gt;通用能力不受损" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontSize=12;fontColor=#173404;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="206" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="joint" value="&lt;b&gt;联合目标&lt;/b&gt;&lt;br&gt;遗忘信号与保留信号按权重合成&lt;br&gt;单一更新，回传更新学生参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=12;fontColor=#2C2C2A;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="300" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="student" value="&lt;b&gt;学生模型（训练中）&lt;/b&gt;&lt;br&gt;从原模型副本出发&lt;br&gt;每轮根据合并后的更新信号&lt;br&gt;整体调整参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=12;fontColor=#042C53;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="380" width="240" height="88" as="geometry" />
        </mxCell>

        <mxCell id="kl" value="&lt;b&gt;遗忘信号（有界拉近）&lt;/b&gt;&lt;br&gt;逐词向升温教师的分布对齐：&lt;br&gt;抹除事实内容、保留语言形式&lt;br&gt;（区别于无限推离的对照路线）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=12;fontColor=#26215C;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="480" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fallback" value="&lt;b&gt;异常兜底&lt;/b&gt;&lt;br&gt;训练中输出退化为乱码或过度无知&lt;br&gt;→ 回退到最近安全检查点&lt;br&gt;调低平滑强度或遗忘权重后重启" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;dashed=1;fontSize=12;fontColor=#501313;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="480" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="contrast" value="&lt;b&gt;对照路线（现有方法）&lt;/b&gt;&lt;br&gt;梯度硬性推离 / 硬编码拒答&lt;br&gt;→ 乱码 / 过度无知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;dashed=1;fontSize=12;fontColor=#501313;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="df" value="&lt;b&gt;遗忘集&lt;/b&gt;&lt;br&gt;待抹除的目标问答对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=12;fontColor=#26215C;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="smooth" value="&lt;b&gt;计算记忆衰减权重&lt;/b&gt;&lt;br&gt;对注意力打分做升温平滑：&lt;br&gt;尖锐的高置信事实关联被摊平&lt;br&gt;宽泛的语法模式保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=12;fontColor=#26215C;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="640" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="teacher" value="&lt;b&gt;冻结教师&lt;/b&gt;&lt;br&gt;升温平滑后的原模型副本&lt;br&gt;只提供参照分布，自身不更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CECBF6;strokeColor=#534AB7;fontSize=12;fontColor=#26215C;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="640" width="240" height="88" as="geometry" />
        </mxCell>

        <mxCell id="calib" value="&lt;b&gt;平滑强度阈值判定&lt;/b&gt;&lt;br&gt;用升温教师试答遗忘问题，&lt;br&gt;检查输出连贯性：&lt;br&gt;连贯可用 → 采用当前强度&lt;br&gt;出现乱码 → 判定过强" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontSize=12;fontColor=#633806;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="640" width="230" height="96" as="geometry" />
        </mxCell>

        <mxCell id="taunote" value="平滑强度经验区间：过弱抹不净、过强产生乱码；由二分搜索在「输出连贯」约束下选定" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F5E5A;" vertex="1" parent="1">
          <mxGeometry x="920" y="744" width="230" height="44" as="geometry" />
        </mxCell>

        <mxCell id="e_trigger_dr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444441;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="trigger" target="dr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_trigger_df" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444441;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="trigger" target="df">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="24" y="124" />
              <mxPoint x="24" y="675" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_df_contrast" value="对照路线" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A32D2D;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#A32D2D;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="df" target="contrast">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_df_student" value="初始化副本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444441;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="df" target="student">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="295" y="661" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_df_smooth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#534AB7;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=1;exitY=0.7;entryX=0;entryY=0.6;" edge="1" parent="1" source="df" target="smooth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_smooth_teacher" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#534AB7;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="smooth" target="teacher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_teacher_calib" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#854F0B;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="teacher" target="calib">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_teacher_kl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#534AB7;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="teacher" target="kl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_student_kl" value="有界对齐" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#185FA5;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="student" target="kl">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="590" y="424" />
              <mxPoint x="590" y="525" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_student_retain" value="效用保持" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444441;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="student" target="retain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dr_retain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444441;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dr" target="retain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_kl_joint" value="遗忘信号" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#534AB7;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="kl" target="joint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_retain_joint" value="保留信号" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#185FA5;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="retain" target="joint">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="590" y="211" />
              <mxPoint x="590" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_joint_effect" value="每轮更新后检查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444441;strokeWidth=1.5;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="joint" target="effect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_effect_out" value="达标：确认遗忘完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B6D11;strokeWidth=1.5;fontSize=11;fontColor=#173404;endArrow=block;endFill=1;exitX=1;exitY=0.35;entryX=0;entryY=0.3;" edge="1" parent="1" source="effect" target="output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_effect_student" value="未达标：继续下一轮" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#444441;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#444441;endArrow=block;endFill=1;exitX=0;exitY=0.75;entryX=1;entryY=0.7;" edge="1" parent="1" source="effect" target="student">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="239" />
              <mxPoint x="600" y="441" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_effect_fallback" value="输出退化" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A32D2D;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#A32D2D;endArrow=block;endFill=1;exitX=1;exitY=0.9;entryX=0;entryY=0.4;" edge="1" parent="1" source="effect" target="fallback">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="890" y="251" />
              <mxPoint x="890" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_calib_fallback" value="过强：乱码" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A32D2D;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#A32D2D;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="calib" target="fallback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fallback_smooth" value="回退：调低强度 / 权重" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#854F0B;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#633806;endArrow=block;endFill=1;exitX=0;exitY=0.8;entryX=0.5;entryY=1;" edge="1" parent="1" source="fallback" target="smooth">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="890" y="560" />
              <mxPoint x="890" y="772" />
              <mxPoint x="440" y="772" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

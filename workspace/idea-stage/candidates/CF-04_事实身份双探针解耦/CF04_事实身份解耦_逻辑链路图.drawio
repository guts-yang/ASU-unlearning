        <mxCell id="lossTitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#5F5E5A;" value="激活对齐损失 → 总损失 → 反传（仅优化 Student θ）→ 输出" vertex="1">
          <mxGeometry height="22" width="1050" x="1654" y="84" as="geometry" />
        </mxCell>
        <mxCell id="b2Title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#534AB7;" value="② ΔA 双探针解耦子链（CF-04 核心新增）：承接 ① 的 ΔA，输出 ΔÂ_pot 进入 ① 的目标构造 T_{ℓ,p}" vertex="1">
          <mxGeometry height="22" width="2660" x="40" y="392" as="geometry" />
        </mxCell>
        <mxCell id="b3Title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#185FA5;" value="③ 单个 DecoderLayer（合并展示）：内部拓扑沿用 v0.6.1、逐层重复 16 层、参数独立；中间层激活 h_ℓ(p) 在此取出供 ① 取 ΔA 与 h_{S,ℓ}" vertex="1">
          <mxGeometry height="22" width="2660" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="tInput" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;遗忘集合 / 反事实配对输入&lt;/b&gt;&lt;br&gt;$$\mathcal{D}_F=\{(X^{+},y^{+})\},\quad X^{-}=X(s_r,r)$$$$X^{+}\!\oplus y^{+}\ \text{vs}\ X^{-}\!\oplus y^{+}$$" vertex="1">
          <mxGeometry height="100" width="230" x="40" y="112" as="geometry" />
        </mxCell>
        <mxCell id="tEmbed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;Embedding（模型入口）&lt;/b&gt;&lt;br&gt;$$h^{(0)}=E[\mathrm{ids}]$$" vertex="1">
          <mxGeometry height="100" width="170" x="286" y="112" as="geometry" />
        </mxCell>
        <mxCell id="tMiddle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontSize=11;fontColor=#2C2C2A;arcSize=10;strokeWidth=2;" value="&lt;b&gt;LLaMA DecoderLayer ×16&lt;/b&gt;&lt;br&gt;$$\text{逐层重复；内部拓扑见 ③}$$" vertex="1">
          <mxGeometry height="100" width="250" x="484" y="112" as="geometry" />
        </mxCell>
        <mxCell id="tPlus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;前向 ①  X⁺⊕y⁺&lt;/b&gt;&lt;br&gt;$$A^{+}_{T,\ell}(p)=h_{T,\ell}(X^{+}\!\oplus y^{+};p)$$" vertex="1">
          <mxGeometry height="48" width="260" x="778" y="112" as="geometry" />
        </mxCell>
        <mxCell id="tMinus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;前向 ②  X⁻⊕y⁺&lt;/b&gt;&lt;br&gt;$$A^{-}_{T,\ell}(p)=h_{T,\ell}(X^{-}\!\oplus y^{+};p)$$" vertex="1">
          <mxGeometry height="48" width="260" x="778" y="164" as="geometry" />
        </mxCell>
        <mxCell id="tDelta" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CECBF6;strokeColor=#534AB7;fontSize=11;fontColor=#2C2C2A;arcSize=10;strokeWidth=2;" value="&lt;b&gt;中间层激活差 / 净化（核心机制，替换原 Teacher 预测分布）&lt;/b&gt;&lt;br&gt;$$\Delta A_{\ell,p}=A^{+}_{T,\ell}(p)-A^{-}_{T,\ell}(p),\;p\in S_f$$" vertex="1">
          <mxGeometry height="100" width="384" x="1220" y="112" as="geometry" />
        </mxCell>
        <mxCell id="sInput" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;$$\mathcal{D}_F,\ \mathcal{D}_R,\quad X^{+}\!\oplus y^{+}$$" vertex="1">
          <mxGeometry height="100" width="230" x="40" y="260" as="geometry" />
        </mxCell>
        <mxCell id="sEmbed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;Embedding&lt;/b&gt;&lt;br&gt;$$h^{(0)}=E[\mathrm{ids}]$$" vertex="1">
          <mxGeometry height="100" width="170" x="286" y="260" as="geometry" />
        </mxCell>
        <mxCell id="sMiddle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontSize=11;fontColor=#2C2C2A;arcSize=10;strokeWidth=2;" value="&lt;b&gt;LLaMA DecoderLayer ×16（可训练 θ）&lt;/b&gt;&lt;br&gt;$$\text{逐层重复；}\ h_{S,\ell}\ \text{在此取出}$$" vertex="1">
          <mxGeometry height="100" width="250" x="472" y="260" as="geometry" />
        </mxCell>
        <mxCell id="sAct" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;答案 / 推理跨度激活（替换原预测分布）&lt;/b&gt;&lt;br&gt;$$h_{S,\ell}(X^{+}\!\oplus y^{+};p),\;p\in S_f$$&lt;br&gt;$$r_f\ \text{经冻结下游重算，不直接过 LM head}$$" vertex="1">
          <mxGeometry height="100" width="300" x="738" y="260" as="geometry" />
        </mxCell>
        <mxCell id="sTarget" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontSize=11;fontColor=#2C2C2A;arcSize=10;strokeWidth=2;" value="&lt;b&gt;遗忘目标 T_{ℓ,p}（stopgrad，新增目标构造）&lt;/b&gt;&lt;br&gt;$$T_{\ell,p}=\operatorname{stopgrad}\!\left(\Pi_{\mathcal K}\!\left[h^{+}_{\ell}(p)-\alpha\,\widehat{\Delta A_{\text{pot},\ell,p}}\right]\right)$$$$\mathcal K=\{h:\ r_{f,p}\le c,\ s_{d_j,p}\le d_j,\ \lVert\Delta r_{E,p}\rVert\le e\}$$" vertex="1">
          <mxGeometry height="100" width="420" x="1194" y="260" as="geometry" />
        </mxCell>
        <mxCell id="lossF" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;遗忘损失 L_F（替换为激活距离）&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_F=\frac{1}{|\Lambda(k)||S_f|}\sum_{\ell\in\Lambda(k)}\sum_{p\in S_f}\rho_\ell(k)\operatorname{dist}\!\left(h_{S,\ell}(p),T_{\ell,p}\right)$$$$\lambda_{KL}^{(\mathrm{ablation})}=0\ \text{（不做 KL 蒸馏）}$$" vertex="1">
          <mxGeometry height="100" width="470" x="1654" y="112" as="geometry" />
        </mxCell>
        <mxCell id="lossR" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;保留损失 L_R（独立保留集 NLL）&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_R=\mathbb{E}_{(x,y)\sim\mathcal{D}_R}\!\left[-\log p_\theta(y\mid x)\right]$$" vertex="1">
          <mxGeometry height="76" width="267" x="1654" y="224" as="geometry" />
        </mxCell>
        <mxCell id="total" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;总损失&lt;/b&gt;&lt;br&gt;$$\mathcal{L}=\lambda_F\mathcal{L}_F+\beta\mathcal{L}_R$$" vertex="1">
          <mxGeometry height="96" width="150" x="2160" y="112" as="geometry" />
        </mxCell>
        <mxCell id="back" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;反向传播（替换：仅优化 Student θ）&lt;/b&gt;&lt;br&gt;$$\nabla_{\theta}\mathcal{L}\ \text{only},\quad \theta_0\ \text{frozen (stopgrad)},\quad \theta\leftarrow\theta-\eta\nabla_{\theta}\mathcal{L}$$" vertex="1">
          <mxGeometry height="62" width="316" x="2077" y="279" as="geometry" />
        </mxCell>
        <mxCell id="out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontSize=11;fontColor=#2C2C2A;arcSize=10;strokeWidth=2;" value="&lt;b&gt;输出（结果，新增终点）&lt;/b&gt;&lt;br&gt;$$\theta^{*}\ \text{：参数内化、无 hook、具备遗忘且保效用的 Student 模型}$$" vertex="1">
          <mxGeometry height="72" width="323" x="2396" y="173" as="geometry" />
        </mxCell>
        <mxCell id="probe" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#AFA9EC;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;① 双冻结探针（新增）&lt;/b&gt;&lt;br&gt;$$z_{\text{fact}}=\phi_{\text{fact}}(\Delta A_{\ell,p}),\quad z_{\text{id}}=\phi_{\text{id}}(\Delta A_{\ell,p})$$&lt;br&gt;$$\mathrm{AUC}_f,\ \mathrm{AUC}_{\text{id}}\quad(\text{经冻结下游重算，不直接过 LM head})$$" vertex="1">
          <mxGeometry height="132" width="650" x="40" y="420" as="geometry" />
        </mxCell>
        <mxCell id="deflate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#AFA9EC;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;② 正交收缩去身份（新增）&lt;/b&gt;&lt;br&gt;$$\Delta A_{\text{fact}}=\big(I-V_{\text{id}}V_{\text{id}}^{\top}\big)\Delta A,\quad \Delta A_{\text{id}}=V_{\text{id}}V_{\text{id}}^{\top}\Delta A$$&lt;br&gt;$$p\in S_f\quad(\text{只保留与身份正交的分量})$$" vertex="1">
          <mxGeometry height="132" width="650" x="706" y="420" as="geometry" />
        </mxCell>
        <mxCell id="pot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#AFA9EC;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;③ 反事实激活潜力（新增）&lt;/b&gt;&lt;br&gt;$$\Delta A_{\text{pot}}=\Delta A_{\text{fact}}+\sum_{j}\lambda_j u_j,\quad u_j\perp V_{\text{id}},\ \left|\partial r_f/\partial u_j\right|&gt;\tau_{\text{pot}}$$&lt;br&gt;$$\text{补回被身份方向掩盖、但对事实读出}\ r_f\ \text{有因果潜力的分量}$$" vertex="1">
          <mxGeometry height="132" width="650" x="1372" y="420" as="geometry" />
        </mxCell>
        <mxCell id="purity" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CECBF6;strokeColor=#534AB7;fontSize=11;fontColor=#2C2C2A;arcSize=10;strokeWidth=2;fontSize=12;" value="&lt;b&gt;④ 纯度证书 / wrong-donor 硬检验（新增，可证伪门）&lt;/b&gt;&lt;br&gt;$$\mathcal P=\mathrm{AUC}_f(\Delta A_{\text{pot}})-\mathrm{AUC}_{\text{id}}(\Delta A_{\text{pot}})$$&lt;br&gt;$$\frac{\lVert V_{\text{id}}V_{\text{id}}^{\top}\Delta A^{\text{wrong}}\rVert}{\lVert\Delta A^{\text{wrong}}\rVert}\ge\pi_{\text{id}}\ \Rightarrow\ \widehat{\Delta A_{\text{pot}}}\ \text{进入 ① 的目标构造}$$" vertex="1">
          <mxGeometry height="132" width="650" x="2038" y="420" as="geometry" />
        </mxCell>
        <mxCell id="layer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#85B7EB;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;单个 DecoderLayer&lt;/b&gt;&lt;br&gt;$$\text{RMSNorm}\to Q/K/V\to\text{RoPE}\to\text{FlashAttention2}\to O\to\text{残差①}\to\text{RMSNorm}\to\text{Gate/Up}\to\text{SwiGLU}\to\text{Down}\to\text{残差②}\to h^{(\ell)}$$$$\text{逐层重复 16 层、各层参数独立}$$" vertex="1">
          <mxGeometry height="100" width="1900" x="40" y="608" as="geometry" />
        </mxCell>
        <mxCell id="layerNote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;Teacher / Student 区分点&lt;/b&gt;&lt;br&gt;$$\text{Teacher：冻结}\ \theta_0,\ \text{stopgrad，仅前向，双前向取}\ A^{+}/A^{-}\Rightarrow\Delta A$$$$\text{Student：可训练}\ \theta,\ h_{S,\ell}\ \text{对齐}\ T_{\ell,p};\quad \text{区分点非}\ \tau$$" vertex="1">
          <mxGeometry height="100" width="734" x="1956" y="608" as="geometry" />
        </mxCell>

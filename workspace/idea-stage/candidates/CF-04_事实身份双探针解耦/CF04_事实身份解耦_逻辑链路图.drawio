        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#26215C;" value="CF-04 事实 / 身份双探针正交解耦 ΔA_fact —— 逻辑链路图" vertex="1">

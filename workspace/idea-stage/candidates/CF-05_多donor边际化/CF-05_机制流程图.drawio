          <mxGeometry height="92" width="250" x="406" y="104" as="geometry" />
        </mxCell>
        <mxCell id="tMinus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;前向 ②  X⁻⊕y⁺&lt;/b&gt;&lt;br&gt;$$A^{-}_{T,(k),\ell}(p)=h_{T,\ell}(X^{-}_{(k)}\!\oplus y^{+};p)$$" vertex="1">
          <mxGeometry height="92" width="272" x="672" y="104" as="geometry" />
        </mxCell>
        <mxCell id="tDelta" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CECBF6;strokeColor=#534AB7;fontSize=11;fontColor=#2C2C2A;arcSize=10;strokeWidth=2;" value="&lt;b&gt;中间层激活差 / 净化（核心机制）&lt;/b&gt;&lt;br&gt;$$\Delta A_{\text{marg},\ell,p}=U^{(r)}_{\ell,p}U^{(r)\top}_{\ell,p}\,\overline{\Delta A}_{\ell,p}$$" vertex="1">
          <mxGeometry height="92" width="538" x="406" y="210" as="geometry" />
        </mxCell>
        <mxCell id="sFwd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;前向传播（逐层）&lt;/b&gt;&lt;br&gt;$$h^{(\ell)}=\mathrm{Dec}_{\ell}(h^{(\ell-1)};\theta)$$" vertex="1">
          <mxGeometry height="92" width="270" x="982" y="104" as="geometry" />
        </mxCell>
        <mxCell id="sAct" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;答案 / 推理跨度激活&lt;/b&gt;&lt;br&gt;$$h_{S,\ell}(X^{+}\!\oplus y^{+};p),\;p\in S_f$$" vertex="1">
          <mxGeometry height="92" width="270" x="1268" y="104" as="geometry" />
        </mxCell>
        <mxCell id="sTarget" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontSize=11;fontColor=#2C2C2A;arcSize=10;strokeWidth=2;" value="&lt;b&gt;遗忘目标 T_{ℓ,p}（stopgrad）&lt;/b&gt;&lt;br&gt;$$T_{\ell,p}=\operatorname{stopgrad}\!\left(\Pi_{\mathcal K}\!\left[h^{+}_{\ell}(p)-\alpha\widehat{\Delta A_{\text{marg},\ell,p}}\right]\right)$$" vertex="1">
          <mxGeometry height="92" width="556" x="982" y="210" as="geometry" />
        </mxCell>
        <mxCell id="lossF" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;遗忘损失  L_F&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_F=\frac{1}{|\Lambda(k)||S_f|}\sum_{\ell\in\Lambda(k)}\sum_{p\in S_f}\rho_\ell(k)\,\operatorname{dist}\!\left(h_{S,\ell}(p),T_{\ell,p}\right)$$" vertex="1">
          <mxGeometry height="92" width="406" x="1608" y="84" as="geometry" />
        </mxCell>
        <mxCell id="lossR" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;保留损失 L_R（源 D_R）&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_R=\mathbb{E}_{(x,y)\sim\mathcal{D}_R}\!\left[-\log p_\theta(y\mid x)\right]$$" vertex="1">
          <mxGeometry height="76" width="406" x="1608" y="186" as="geometry" />
        </mxCell>
        <mxCell id="total" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;总损失&lt;/b&gt;&lt;br&gt;$$\mathcal{L}=\lambda_F\mathcal{L}_F+\beta\mathcal{L}_R,\quad \lambda_{KL}^{(\mathrm{ablation})}=0$$" vertex="1">
          <mxGeometry height="88" width="406" x="1608" y="272" as="geometry" />
        </mxCell>
        <mxCell id="back" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontSize=11;fontColor=#2C2C2A;arcSize=10;" value="&lt;b&gt;反向传播（优化的参数）&lt;/b&gt;&lt;br&gt;$$\nabla_{\theta}\mathcal{L}\;\text{only},\quad \theta_0\ \text{frozen (stopgrad)},\quad \theta\leftarrow\theta-\eta\nabla_{\theta}\mathcal{L}$$" vertex="1">
          <mxGeometry height="104" width="306" x="2054" y="84" as="geometry" />
        </mxCell>
        <mxCell id="out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontSize=11;fontColor=#2C2C2A;arcSize=10;strokeWidth=2;" value="&lt;b&gt;输出（结果）&lt;/b&gt;&lt;br&gt;$$\theta^{*}\ \text{：参数内化、无 hook、具备遗忘且保效用的 Student 模型}$$" vertex="1">
          <mxGeometry height="118" width="306" x="2054" y="210" as="geometry" />
        </mxCell>
        <mxCell id="det0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#AFA9EC;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;① K-donor 配对差&lt;/b&gt;&lt;br&gt;$$\Delta A^{(k)}_{\ell,p}=A^{+}_{T,\ell}(p)-A^{-}_{T,(k),\ell}(p),\quad k=1..K,\quad p\in S_f$$&lt;br&gt;$$\text{donor 全来自 TOFU 内部保留集、按作者/别名簇隔离}$$" vertex="1">
          <mxGeometry height="132" width="760" x="40" y="418" as="geometry" />
        </mxCell>
        <mxCell id="det1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#AFA9EC;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;② 堆叠与边际均值&lt;/b&gt;&lt;br&gt;$$\overline{\Delta A}_{\ell,p}=\frac{1}{K}\sum_{k=1}^{K}\Delta A^{(k)}_{\ell,p},\quad M_{\ell,p}=\big[\Delta A^{(1)}_{\ell,p}\ \cdots\ \Delta A^{(K)}_{\ell,p}\big]$$" vertex="1">
          <mxGeometry height="96" width="760" x="824" y="418" as="geometry" />
        </mxCell>
        <mxCell id="det2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#AFA9EC;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;③ SVD 共有子空间&lt;/b&gt;&lt;br&gt;$$M_{\ell,p}=U^{(r)}_{\ell,p}\Sigma^{(r)}_{\ell,p}V^{(r)\top}_{\ell,p}+E_{\ell,p},\quad \Delta A_{\text{marg},\ell,p}=U^{(r)}_{\ell,p}U^{(r)\top}_{\ell,p}\,\overline{\Delta A}_{\ell,p}$$&lt;br&gt;$$\Delta A^{(k)}_{\text{priv}}=\Delta A^{(k)}_{\ell,p}-\Delta A_{\text{marg},\ell,p}\ (\text{投影掉})$$" vertex="1">
          <mxGeometry height="132" width="760" x="1608" y="418" as="geometry" />
        </mxCell>
        <mxCell id="det3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#AFA9EC;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;④ 目标（非 donor）&lt;/b&gt;&lt;br&gt;$$\mathcal K=\{h: r_{f,p}\le c,\ s_{d_j,p}\le d_j,\ \lVert\Delta r_{E,p}\rVert\le e\},\quad T_{\ell,p}=\operatorname{stopgrad}\!\left(\Pi_{\mathcal K}[h^{+}_{\ell}(p)-\alpha\widehat{\Delta A_{\text{marg},\ell,p}}]\right)$$" vertex="1">
          <mxGeometry height="96" width="760" x="40" y="566" as="geometry" />
        </mxCell>
        <mxCell id="det4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#AFA9EC;fontSize=11;fontColor=#2C2C2A;arcSize=10;fontSize=12;" value="&lt;b&gt;⑤ 损失 / 反传 / 输出&lt;/b&gt;&lt;br&gt;$$\mathcal{L}=\lambda_F\mathcal{L}_F+\beta\mathcal{L}_R,\quad \lambda_{KL}^{(\mathrm{ablation})}=0,\quad \nabla_{\theta}\mathcal{L}\ \text{仅}\ \theta,\quad \Rightarrow\theta^{*}$$" vertex="1">
          <mxGeometry height="96" width="760" x="824" y="566" as="geometry" />
        </mxCell>

        <mxCell id="evDqB6XLGpq_kgqXfnr7-7" edge="1" parent="1" source="evDqB6XLGpq_kgqXfnr7-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.236;entryY=0.014;entryDx=0;entryDy=0;entryPerimeter=0;" target="detailTeacherPanel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="teacherNote" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#526079;fontSize=10;fontFamily=Helvetica;" value="配对约束：单主体替换、token 等长、槽位对齐；donor y⁻ 仅作单边约束测量、不作训练目标；Teacher 全冻结、无注意力温度（eager）；缓存选定层（默认 8/10/12/14）状态。" vertex="1">
          <mxGeometry height="22" width="1490" x="42" y="114" as="geometry" />
        </mxCell>
        <mxCell id="brcdDecompose" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;strokeWidth=1.3;fontColor=#17243B;fontSize=11;spacing=4;align=left;verticalAlign=middle;" value="&lt;b&gt;① 双分解（选定层 attention 的 π·V）&lt;/b&gt;&lt;br&gt;$$D_r=\tfrac12\sum_q(\pi^+_q-\pi^-_q)(v^+_q+v^-_q)$$ 路由「看哪里」$$D_c=\tfrac12\sum_q(\pi^+_q+\pi^-_q)(v^+_q-v^-_q)$$ 内容「读出什么」" vertex="1">
          <mxGeometry height="165" width="237" x="64" y="683" as="geometry" />
        </mxCell>
        <mxCell id="brcdGate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;strokeWidth=1.3;fontColor=#17243B;fontSize=11;spacing=4;align=left;verticalAlign=middle;" value="&lt;b&gt;② true / null patch 唯一分量门&lt;/b&gt;&lt;br&gt;冻结 Teacher，答案跨度 $$H^+\leftarrow H^+-\alpha C$$ 后重跑后续层&lt;br&gt;比较原答案 NLL 增量与形状匹配的 null 分量效应（mean_e&amp;gt;0, mean_s&amp;gt;0）&lt;br&gt;family 内恰好一项通过 → 选 $$C^*$$；都过 / 都不过 / 跨族歧义 → 不选&lt;br&gt;&lt;font style=&#39;font-size:9px;color:#526079&#39;&gt;严格档任一层无唯一分量 → 不启动训练&lt;/font&gt;" vertex="1">
          <mxGeometry height="175" width="460" x="580" y="668" as="geometry" />
        </mxCell>
        <mxCell id="brcdTarget" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;strokeWidth=1.3;fontColor=#17243B;fontSize=11;spacing=4;align=left;verticalAlign=middle;" value="&lt;b&gt;③ 固定激活目标&lt;/b&gt;&lt;br&gt;$$T=\operatorname{stopgrad}(A^+-\alpha C^*)$$，默认 $$\alpha=0.1$$&lt;br&gt;仅作用于选中层 × 答案跨度；Teacher 与目标 stop-gradient&lt;br&gt;Student 学「原状态减去少量筛选分量」，不是对齐 donor 状态&lt;br&gt;&lt;font style=&#39;font-size:9px;color:#526079&#39;&gt;T 作为 L_BRCD 的第二输入，与 h_S⁺ 一起进入激活内化损失&lt;/font&gt;" vertex="1">
          <mxGeometry height="132" width="850" x="1566" y="689.5" as="geometry" />
        </mxCell>
        <mxCell id="brcdE0" edge="1" parent="1" source="brcdDecompose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BA7517;strokeWidth=1.4;endArrow=block;endFill=1;fontColor=#BA7517;fontSize=10;fontFamily=Helvetica;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="EMwoLCWx5fO0WbYxm1HD-2" value="">
